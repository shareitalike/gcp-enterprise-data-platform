# ─────────────────────────────────────────────────────────────────────────────
# GCP Commerce360 — Environment Configuration Template
#
# USAGE:
#   cp .env.example .env
#   Edit .env with your real values
#   .env is git-ignored — NEVER commit real credentials
# ─────────────────────────────────────────────────────────────────────────────

# ── GCP Project IDs ──────────────────────────────────────────────────────────
# These are injected at runtime. Never hardcode project IDs in source code.
INGESTION_PROJECT_ID=commerce360-ingest-dev
ANALYTICS_PROJECT_ID=commerce360-analytics-dev

# ── GCP Region ───────────────────────────────────────────────────────────────
GCP_REGION=us-central1
GCP_ZONE=us-central1-a

# ── GCS Buckets ──────────────────────────────────────────────────────────────
# Owned by Project A. Must be globally unique.
RAW_BUCKET_NAME=c360-raw-ingest-dev

# ── BigQuery ─────────────────────────────────────────────────────────────────
BQ_BRONZE_DATASET=bronze
BQ_SILVER_DATASET=silver
BQ_GOLD_DATASET=gold
BQ_CONTROL_DATASET=control
BQ_AUDIT_DATASET=audit
BQ_QUARANTINE_DATASET=quarantine
BQ_QUALITY_DATASET=quality

# ── Pub/Sub Topics (Project A) ────────────────────────────────────────────────
PUBSUB_ORDERS_TOPIC=orders-created
PUBSUB_CLICKSTREAM_TOPIC=clickstream-events

# ── Pub/Sub Subscriptions (Project B) ────────────────────────────────────────
PUBSUB_ORDERS_SUBSCRIPTION=orders-created-sub
PUBSUB_CLICKSTREAM_SUBSCRIPTION=clickstream-events-sub

# ── Service Accounts ─────────────────────────────────────────────────────────
# These SAs are created by Terraform. Fill in after Phase 2.
INGESTION_SA_EMAIL=
ANALYTICS_INGESTION_SA_EMAIL=
ANALYTICS_STREAMING_SA_EMAIL=

# ── Data Generator ────────────────────────────────────────────────────────────
DATA_GEN_SEED=42
DATA_GEN_TIER=small          # small | medium | large
DATA_GEN_OUTPUT_DIR=data/generated/small
DATA_GEN_FORMAT=json         # json | csv | parquet

# ── Local Development ─────────────────────────────────────────────────────────
# Set to true to bypass GCP calls during local unit tests
LOCAL_DEV_MODE=true

# ── Authentication ────────────────────────────────────────────────────────────
# Use Application Default Credentials (ADC). Do NOT set GOOGLE_APPLICATION_CREDENTIALS
# to a key file. Use 'gcloud auth application-default login' instead.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json   ← NEVER do this
