{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "clickstream_events/1.0",
  "title": "ClickstreamEvent",
  "type": "object",
  "required": [
    "event_id", "session_id", "anonymous_id", "event_type",
    "event_timestamp", "ingestion_timestamp", "page_url",
    "device_type", "user_agent_hash", "ip_country", "_schema_version"
  ],
  "properties": {
    "event_id":            { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
    "session_id":          { "type": "string", "minLength": 1 },
    "customer_id":         { "type": ["string", "null"] },
    "anonymous_id":        { "type": "string", "minLength": 1 },
    "event_type":          { "type": "string", "enum": ["PAGE_VIEW", "PRODUCT_VIEW", "ADD_TO_CART", "CHECKOUT", "PURCHASE", "SEARCH"] },
    "event_timestamp":     { "type": "string", "format": "date-time" },
    "ingestion_timestamp": { "type": "string", "format": "date-time" },
    "page_url":            { "type": "string", "minLength": 1 },
    "referrer_url":        { "type": ["string", "null"] },
    "product_id":          { "type": ["string", "null"] },
    "search_query":        { "type": ["string", "null"] },
    "device_type":         { "type": "string", "enum": ["DESKTOP", "MOBILE", "TABLET"] },
    "user_agent_hash":     { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "ip_country":          { "type": "string", "pattern": "^[A-Z]{2}$" },
    "_schema_version":     { "type": "string" }
  },
  "additionalProperties": false
}
